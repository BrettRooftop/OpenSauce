# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# FACEBOOK_ACCESS_TOKEN: Required to fetch the Facebook Gallery of SAWS warnings in chronological order.
FACEBOOK_ACCESS_TOKEN=

# APIFY_API_TOKEN: Optional fallback for scraping Facebook if you don't have an admin page token
APIFY_API_TOKEN=
